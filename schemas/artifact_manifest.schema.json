{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "artifact_manifest_id": {
      "minLength": 1,
      "type": "string"
    },
    "artifact_status": {
      "type": "string"
    },
    "artifacts": {
      "items": {
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "artifact_type": {
            "type": "string"
          },
          "exists": {
            "type": "boolean"
          },
          "hash": {
            "type": "object"
          },
          "path": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "path",
          "artifact_type",
          "role",
          "required",
          "exists",
          "hash"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "authority_flags": {
      "additionalProperties": false,
      "properties": {
        "correctness_proven": {
          "const": false
        },
        "repo_mutated": {
          "const": false
        },
        "source_control_touched": {
          "const": false
        },
        "state_promoted": {
          "const": false
        }
      },
      "required": [
        "correctness_proven",
        "repo_mutated",
        "state_promoted",
        "source_control_touched"
      ],
      "type": "object"
    },
    "created_at": {
      "type": "string"
    },
    "packet_id": {
      "minLength": 1,
      "type": "string"
    },
    "record_type": {
      "const": "artifact_manifest"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "packet_id",
    "artifact_manifest_id",
    "artifact_status",
    "artifacts",
    "authority_flags"
  ],
  "title": "artifact_manifest",
  "type": "object"
}
